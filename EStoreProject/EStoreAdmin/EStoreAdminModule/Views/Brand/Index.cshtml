@using EStoreAdminModel.Models.Brands
@model List<BrandModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<html>
<head>
    <title>List Of Brands</title>
    <link href="~/Bootstrap/css/bootstrap.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="row mt-3">
            <div class="h1 text-center bg-primary">
                LIST OF BRANDS
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-lg-3 col-md-3 col-sm-3">
                <a class="btn btn-primary"
                   asp-controller="Brand"
                   asp-action="CreateBrand">Create Brand</a>
            </div>
        </div>

        <div class="row mt-3">
            <table class="table table-primary table-hover">
                <thead>
                    <tr>
                        <td class="h3">Brand Id</td>
                        <td class="h3">Brand Name</td>
                        <td class="h3">Delete</td>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="txt-center h1">No Brands Found</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (BrandModel brandModel in Model)
                        {
                            <tr>
                                <td>@brandModel.Id</td>
                                <td>@brandModel.Name</td>
                                <td>
                                    <a class="btn btn-danger"
                                       asp-controller="Brand"
                                       asp-action="DeleteBrand"
                                       asp-route-id="@brandModel.Id">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>